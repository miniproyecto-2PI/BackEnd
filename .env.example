# ==============================================================================
# SALÓN DE ESTUDIO COLABORATIVO - VARIABLES DE ENTORNO (EJEMPLO)
# Copie este archivo a '.env' y complete con sus valores reales.
# NUNCA suba el archivo '.env' con valores reales al repositorio de Git.
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Puerto y host del servidor HTTP (Render inyecta PORT automáticamente en producción)
PORT=3000
HOST=0.0.0.0

# Orígenes permitidos para CORS (separados por coma o '*' para permitir todos)
# En producción, incluya la URL de su frontend en Vercel: https://su-frontend.vercel.app
CORS_ORIGIN=*

# Nombre de la colección en Firestore para datos de configuración / arquetipo
FIRESTORE_COLLECTION_NAME=system_config

# ==============================================================================
# CONFIGURACIÓN DE FIREBASE ADMIN SDK / FIRESTORE
# Escoja UNA de las siguientes opciones para configurar las credenciales:
# ==============================================================================

# OPCIÓN 1 (Recomendada para Render y Despliegues):
# Todo el contenido del archivo JSON de la cuenta de servicio como un solo string JSON.
# En Render: Cree una variable de entorno llamada FIREBASE_SERVICE_ACCOUNT_KEY y pegue el JSON.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# OPCIÓN 2 (Variables individuales):
# Extraiga los 3 valores principales de su archivo de clave de cuenta de servicio de Firebase.
FIREBASE_PROJECT_ID=tu-proyecto-firebase-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPCIÓN 3 (Ruta local a archivo JSON de clave de cuenta de servicio):
# Descargue la clave de Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada.
# Guarde el archivo en la raíz (ej: serviceAccountKey.json). Está ignorado por .gitignore.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPCIÓN 4 (Solo para emulador local de Firestore, opcional):
# FIRESTORE_EMULATOR_HOST=localhost:8080

