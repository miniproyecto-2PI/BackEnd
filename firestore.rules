rules_version = '2';

// TS-01: el frontend NUNCA lee ni escribe Firestore directamente.
// Todo acceso pasa por la API (Firebase Admin SDK), que ignora estas reglas.
// Por eso se niega cualquier acceso desde los SDK de cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
